# Ansible
*.retry
.vault_pass*
vault_pass*

# Kubernetes & Keys
kubeconfig*
*.kubeconfig
# kubeconfig 파일은 제외하되 Ansible 롤 디렉터리는 추적
!ansible/roles/kubeconfig/
active.yaml
secrets.yml
standby.yaml
*.pem
*.key
id_rsa*

# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Python & Env
__pycache__/
*.py[cod]
.env
.venv/

# Device simulator (인증서/개인키/상태)
device-sim/certs/
device-sim/device_state.json

# 절체 측정 원본 로그 (summary.csv 는 보존)
failover-results/run*.log

# Ansible 롤 디렉터리는 추적한다 (kubeconfig* 패턴의 예외)
!ansible/roles/kubeconfig/
!ansible/roles/kubeconfig_dr/

# Terraform 원격 state 설정(계정 ID 포함)
terraform/backend.hcl

# 환경별 인벤토리(Tailscale IP 등). 예시는 ansible/inventory.ini.example
ansible/inventory.ini
