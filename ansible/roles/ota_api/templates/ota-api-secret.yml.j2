apiVersion: v1
kind: Secret
metadata:
  name: ota-db-secret
  namespace: default
type: Opaque
stringData:
  PG_HOST: {{ cluster_cfg.pg_host | to_json }}
  PG_USER: "ota_admin"
  PG_PASS: {{ pg_password | to_json }}
  PG_DB: "ota_db"
  REDIS_HOST: {{ cluster_cfg.redis_host | to_json }}
  REDIS_PASS: {{ redis_password | to_json }}
