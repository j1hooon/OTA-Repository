apiVersion: v1
kind: Secret
metadata:
  name: ota-db-secret
  namespace: default
type: Opaque
stringData:
  PG_HOST: {{ cluster_cfg.pg_host | to_json }}
  PG_USER: "ota_admin"
  PG_PASS: {{ pg_password | to_json }}
  PG_DB: "ota_db"
  REDIS_HOST: {{ cluster_cfg.redis_host | to_json }}
  REDIS_PASS: {{ redis_password | to_json }}
  AWS_DEFAULT_REGION: {{ aws_region | default('ap-northeast-1') | to_json }}
  AWS_ACCESS_KEY_ID: {{ aws_access_key | default('') | to_json }}
  AWS_SECRET_ACCESS_KEY: {{ aws_secret_access_key | default('') | to_json }}
  IOT_ENDPOINT: {{ iot_endpoint | default('') | to_json }}
