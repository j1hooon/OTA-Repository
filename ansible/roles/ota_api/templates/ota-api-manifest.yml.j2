apiVersion: v1
kind: ConfigMap
metadata:
  name: ota-fastapi-code
  namespace: default
data:
  main.py: |
{{ lookup('file', 'main.py') | indent(4, true) }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ota-api-server
  namespace: default
spec:
  replicas: 2
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 0   # 새 파드가 Ready 가 되기 전에는 기존 파드를 내리지 않음(이미지 풀 실패 시에도 서비스 유지)
      maxSurge: 1
  selector:
    matchLabels:
      app: ota-api
  template:
    metadata:
      labels:
        app: ota-api
    spec:
      terminationGracePeriodSeconds: 15
      containers:
      - name: ota-api
        image: {{ ota_api_image }}
        imagePullPolicy: {{ 'Always' if ota_api_image.endswith(':latest') else 'IfNotPresent' }}
        # exec 형식(셸 없음): uvicorn 이 PID 1 이라 SIGTERM 을 직접 받는다
        command: ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "80", "--app-dir", "/app"]
        ports:
        - containerPort: 80
        env:
        - name: CLUSTER_NAME
          value: "{{ cluster_name }}"
        envFrom:
        - secretRef:
            name: ota-db-secret
        volumeMounts:
        - name: app-code
          mountPath: /app
        readinessProbe:
          httpGet:
            path: /health
            port: 80
          initialDelaySeconds: 3
          periodSeconds: 3
      volumes:
      - name: app-code
        configMap:
          name: ota-fastapi-code
---
apiVersion: v1
kind: Service
metadata:
  name: ota-api-svc
  namespace: default
spec:
  type: NodePort
  selector:
    app: ota-api
  ports:
  - port: 80
    targetPort: 80
    nodePort: {{ ota_nodeport }}
