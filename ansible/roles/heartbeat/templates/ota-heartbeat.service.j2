[Unit]
Description=OTA Platform On-Premise L7 Heartbeat Sender (CloudWatch)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Environment="PATH=/usr/local/bin:/usr/bin:/bin:/snap/bin"
EnvironmentFile=-/etc/default/ota-heartbeat
ExecStart=/usr/local/bin/ota-heartbeat-agent.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
