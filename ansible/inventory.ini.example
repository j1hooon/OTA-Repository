# 복사해서 사용: cp ansible/inventory.ini.example ansible/inventory.ini
# inventory.ini 는 환경별 값(Tailscale IP 등)이 들어가므로 .gitignore 로 추적하지 않는다.
[mgmt]
localhost ansible_connection=local

[k3s_clusters]
active ansible_host=172.16.100.1
standby ansible_host=172.16.200.1

[dr_db]
# terraform apply 후 도쿄 DB 노드의 Tailscale IP: tailscale status | grep <호스트명>
tokyo_db ansible_host=100.x.y.z

[dr_k3s]
# Tailscale IP: EC2 를 재생성하면 바뀐다
dr ansible_host=100.x.y.z
