pipeline {
    agent any

    options {
        timestamps()
        ansiColor('xterm')
    }

    parameters {
        string(name: 'FIRMWARE_VERSION', defaultValue: '1.1.0', description: '배포할 새로운 ESP32 펌웨어 버전')
        string(name: 'RELEASE_NOTES', defaultValue: 'Optimize WiFi reconnection & memory leak fix', description: '릴리즈 노트')
    }

    environment {
        MGMT_IP    = '172.16.10.1'
        RAMDISK    = '/ramdisk/ota-build'
        DISK_DIR   = "${WORKSPACE}/disk-build"
        PG_PASS    = credentials('pg-password')
        REDIS_PASS = credentials('redis-password')
        FIRMWARE_VERSION = "${params.FIRMWARE_VERSION}"
        RELEASE_NOTES    = "${params.RELEASE_NOTES}"
    }

    stages {
        stage('1. Prepare RAM Disk') {
            steps {
                sh '''
                    printf "\\033[1;34m[INFO] 2GB RAM 디스크(/ramdisk) 작업 공간 초기화 중...\\033[0m\\n"
                    rm -rf "${RAMDISK}" "${DISK_DIR}"
                    mkdir -p "${RAMDISK}" "${DISK_DIR}"
                    df -h /ramdisk
                '''
            }
        }

        stage('2. Benchmark: Disk vs RAM Disk (5-Run Median)') {
            steps {
                sh '''#!/bin/bash
                    set -e
                    ITERATIONS=5

                    printf "\\033[1;33m==========================================================================\\033[0m\\n"
                    printf "\\033[1;33m [Track 1] 소형 오브젝트 동기 쓰기(dsync) 순수 I/O 벤치마크 (4KB x 100개, ${ITERATIONS}회 반복)\\033[0m\\n"
                    printf "\\033[1;33m==========================================================================\\033[0m\\n"

                    disk_io_list=()
                    ram_io_list=()

                    for run in $(seq 1 ${ITERATIONS}); do
                        rm -rf "${DISK_DIR}/io_"* "${RAMDISK}/io_"*

                        # 1-A. 일반 디스크 동기 쓰기 (oflag=dsync)
                        s_disk=$(date +%s.%N)
                        for i in $(seq 1 100); do
                            dd if=/dev/zero of="${DISK_DIR}/io_${i}.o" bs=4K count=1 oflag=dsync status=none
                        done
                        e_disk=$(date +%s.%N)
                        t_disk=$(echo "scale=4; ${e_disk} - ${s_disk}" | bc | sed 's/^\\./0./')
                        disk_io_list+=("${t_disk}")

                        # 1-B. RAM 디스크(tmpfs) 동기 쓰기 (oflag=dsync)
                        s_ram=$(date +%s.%N)
                        for i in $(seq 1 100); do
                            dd if=/dev/zero of="${RAMDISK}/io_${i}.o" bs=4K count=1 oflag=dsync status=none
                        done
                        e_ram=$(date +%s.%N)
                        t_ram=$(echo "scale=4; ${e_ram} - ${s_ram}" | bc | sed 's/^\\./0./')
                        ram_io_list+=("${t_ram}")

                        printf "  [Run #%d] Disk(dsync): %s 초  |  tmpfs(dsync): %s 초\\n" "${run}" "${t_disk}" "${t_ram}"
                    done
                    rm -rf "${DISK_DIR}/io_"* "${RAMDISK}/io_"*

                    # 중앙값(Median, 5개 중 정렬 후 3번째 값) 산출
                    DISK_IO_MED=$(printf '%s\n' "${disk_io_list[@]}" | sort -n | sed -n '3p')
                    RAM_IO_MED=$(printf '%s\n' "${ram_io_list[@]}" | sort -n | sed -n '3p')
                    IO_MULTIPLIER=$(echo "scale=1; ${DISK_IO_MED} / ${RAM_IO_MED}" | bc | sed 's/^\\./0./')
                    IO_REDUCTION=$(echo "scale=1; (1 - (${RAM_IO_MED} / ${DISK_IO_MED})) * 100" | bc | sed 's/^\\./0./')

                    printf "\\n\\033[1;33m==========================================================================\\033[0m\\n"
                    printf "\\033[1;33m [Track 2] 전체 펌웨어 빌드(150개 GCC 컴파일 + 4MB 바이너리 병합, ${ITERATIONS}회 반복)\\033[0m\\n"
                    printf "\\033[1;33m==========================================================================\\033[0m\\n"

                    dd if=/dev/urandom of="/tmp/base_assets.bin" bs=1M count=4 status=none

                    disk_build_list=()
                    ram_build_list=()

                    for run in $(seq 1 ${ITERATIONS}); do
                        rm -rf "${DISK_DIR}"/* "${RAMDISK}"/*

                        # 2-A. 일반 디스크 전체 빌드
                        s_b_disk=$(date +%s.%N)
                        for i in $(seq 1 150); do
                            echo "int func_${i}(int x) { return x * ${i}; }" > "${DISK_DIR}/mod_${i}.c"
                            gcc -c "${DISK_DIR}/mod_${i}.c" -o "${DISK_DIR}/mod_${i}.o"
                        done
                        cp "/tmp/base_assets.bin" "${DISK_DIR}/esp32-v${FIRMWARE_VERSION}.bin"
                        cat "${DISK_DIR}"/*.o >> "${DISK_DIR}/esp32-v${FIRMWARE_VERSION}.bin"
                        sync
                        e_b_disk=$(date +%s.%N)
                        tb_disk=$(echo "scale=4; ${e_b_disk} - ${s_b_disk}" | bc | sed 's/^\\./0./')
                        disk_build_list+=("${tb_disk}")

                        # 2-B. RAM 디스크(tmpfs) 전체 빌드
                        s_b_ram=$(date +%s.%N)
                        for i in $(seq 1 150); do
                            echo "int func_${i}(int x) { return x * ${i}; }" > "${RAMDISK}/mod_${i}.c"
                            gcc -c "${RAMDISK}/mod_${i}.c" -o "${RAMDISK}/mod_${i}.o"
                        done
                        cp "/tmp/base_assets.bin" "${RAMDISK}/esp32-v${FIRMWARE_VERSION}.bin"
                        cat "${RAMDISK}"/*.o >> "${RAMDISK}/esp32-v${FIRMWARE_VERSION}.bin"
                        e_b_ram=$(date +%s.%N)
                        tb_ram=$(echo "scale=4; ${e_b_ram} - ${s_b_ram}" | bc | sed 's/^\\./0./')
                        ram_build_list+=("${tb_ram}")

                        printf "  [Run #%d] Disk Build : %s 초  |  tmpfs Build : %s 초\\n" "${run}" "${tb_disk}" "${tb_ram}"
                    done
                    rm -f "/tmp/base_assets.bin"

                    DISK_BUILD_MED=$(printf '%s\n' "${disk_build_list[@]}" | sort -n | sed -n '3p')
                    RAM_BUILD_MED=$(printf '%s\n' "${ram_build_list[@]}" | sort -n | sed -n '3p')
                    BUILD_REDUCTION=$(echo "scale=1; (1 - (${RAM_BUILD_MED} / ${DISK_BUILD_MED})) * 100" | bc | sed 's/^\\./0./')
                    BUILD_MULTIPLIER=$(echo "scale=2; ${DISK_BUILD_MED} / ${RAM_BUILD_MED}" | bc | sed 's/^\\./0./')

                    printf "\\n\\033[1;32m==========================================================================\\033[0m\\n"
                    printf "\\033[1;32m [포트폴리오 정량 지표 요약] 5회 반복 측정 중앙값 (Median)\\033[0m\\n"
                    printf "\\033[1;32m--------------------------------------------------------------------------\\033[0m\\n"
                    printf "  1. 순수 스토리지 동기 쓰기 (I/O 구간, dsync 100 files):\\n"
                    printf "     - 일반 디스크 (Disk) : %s 초\\n" "${DISK_IO_MED}"
                    printf "     - RAM 디스크 (tmpfs) : %s 초  --> \\033[1;36mI/O 속도 약 %s배 향상 (지연시간 %s%% 단축)\\033[0m\\n" "${RAM_IO_MED}" "${IO_MULTIPLIER}" "${IO_REDUCTION}"
                    printf "\\n"
                    printf "  2. 전체 컴파일 + 펌웨어 패키징 (GCC 150 modules + 4MB Binary):\\n"
                    printf "     - 일반 디스크 (Disk) : %s 초\\n" "${DISK_BUILD_MED}"
                    printf "     - RAM 디스크 (tmpfs) : %s 초  --> \\033[1;36m전체 빌드 시간 %s%% 단축 (%s배 가속)\\033[0m\\n" "${RAM_BUILD_MED}" "${BUILD_REDUCTION}" "${BUILD_MULTIPLIER}"
                    printf "\\033[1;32m==========================================================================\\033[0m\\n"
                '''
            }
        }

        stage('3. SHA-256 Hash & Artifact Metadata') {
            steps {
                script {
                    env.FW_FILE = "${RAMDISK}/esp32-v${params.FIRMWARE_VERSION}.bin"
                    env.FW_SHA256 = sh(script: "sha256sum ${env.FW_FILE} | awk '{print \$1}'", returnStdout: true).trim()
                    env.FW_SIZE = sh(script: "stat -c%s ${env.FW_FILE}", returnStdout: true).trim()
                    if (!env.S3_BUCKET?.trim() || !env.CDN_DOMAIN?.trim()) {
                        error('S3_BUCKET / CDN_DOMAIN 이 비어 있습니다. group_vars/all.yml 의 firmware_bucket, cdn_domain 을 채우고 control_tower 를 다시 배포하세요.')
                    }
                    env.FW_KEY = sh(script: "echo firmware/esp32-v${params.FIRMWARE_VERSION}-\$(echo ${env.FW_SHA256} | cut -c1-12).bin", returnStdout: true).trim()
                    env.S3_URL = "https://${env.CDN_DOMAIN}/${env.FW_KEY}"
                }
                sh '''
                    printf "\\033[1;36m[ARTIFACT] 펌웨어 바이너리 무결성 검증 데이터 생성 완료\\033[0m\\n"
                    echo " - Version : ${FIRMWARE_VERSION}"
                    echo " - SHA-256 : ${FW_SHA256}"
                    echo " - Size    : ${FW_SIZE} bytes"
                    echo " - S3 Key  : ${FW_KEY}"
                    echo " - URL     : ${S3_URL}"
                '''
            }
        }

        stage('4. Upload Firmware to S3 (CloudFront Origin)') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'aws-firmware-uploader',
                    usernameVariable: 'AWS_ACCESS_KEY_ID',
                    passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                )]) {
                    sh '''
                        printf "\\033[1;34m[S3] 펌웨어 업로드: s3://${S3_BUCKET}/${FW_KEY}\\033[0m\\n"
                        aws s3 cp "${FW_FILE}" "s3://${S3_BUCKET}/${FW_KEY}" \
                            --content-type application/octet-stream --only-show-errors
                        aws s3api head-object --bucket "${S3_BUCKET}" \
                            --key "${FW_KEY}" \
                            --query ContentLength --output text
                    '''
                }
            }
        }

        stage('5. Update Postgres DB & Evict Redis Cache') {
            steps {
                sh '''
                    printf "\\033[1;34m[DB] PostgreSQL에 신규 펌웨어(${FIRMWARE_VERSION}) 메타데이터 등록 중...\\033[0m\\n"
                    PGPASSWORD="${PG_PASS}" psql -h "${MGMT_IP}" -U ota_admin -d ota_db -c "
                    INSERT INTO firmware_releases (version, s3_url, sha256_hash, file_size_bytes, release_notes)
                    VALUES ('${FIRMWARE_VERSION}', '${S3_URL}', '${FW_SHA256}', ${FW_SIZE}, '${RELEASE_NOTES}')
                    ON CONFLICT (version) DO UPDATE SET
                        s3_url = EXCLUDED.s3_url,
                        sha256_hash = EXCLUDED.sha256_hash,
                        file_size_bytes = EXCLUDED.file_size_bytes,
                        release_notes = EXCLUDED.release_notes,
                        created_at = CURRENT_TIMESTAMP;"

                    printf "\\033[1;33m[REDIS] 기존 캐시(latest_firmware) 즉시 무효화(Eviction) 실행...\\033[0m\\n"
                    redis-cli -h "${MGMT_IP}" -a "${REDIS_PASS}" DEL latest_firmware
                '''
            }
        }

        stage('6. Verify Multi-Cluster OTA Endpoint') {
            steps {
                sh '''
                    printf "\\033[1;32m[VERIFY] HAProxy(:8000)를 통해 신규 펌웨어 배포 상태 및 K3s 클러스터 상태 검증\\033[0m\\n"
                    kubectl get pods --context=active
                    kubectl get pods --context=standby
                    echo ""
                    echo "--- CloudFront 다운로드 및 SHA-256 무결성 검증 (신규 배포 직후엔 전파 지연으로 재시도) ---"
                    curl -fsS --retry 10 --retry-delay 5 --retry-all-errors -o /tmp/fw-verify.bin "${S3_URL}"
                    echo "${FW_SHA256}  /tmp/fw-verify.bin" | sha256sum -c -
                    rm -f /tmp/fw-verify.bin
                    echo ""
                    echo "--- 1차 호출 (Cache Eviction 직후 -> POSTGRES_DB에서 v${FIRMWARE_VERSION} 로드) ---"
                    curl -s "http://${MGMT_IP}:8000/ota/check?device_id=esp32-ci-verifier&current_version=1.0.0"
                    echo ""
                    echo "--- 2차 호출 (자동 재캐싱 완료 -> REDIS_CACHE에서 1ms 응답) ---"
                    RESP=$(curl -s "http://${MGMT_IP}:8000/ota/check?device_id=esp32-ci-verifier&current_version=1.0.0")
                    echo "${RESP}"
                    echo ""
                    echo "--- /ota/check 응답이 방금 배포한 URL/해시와 일치하는지 검증 ---"
                    echo "${RESP}" | grep -qF "${S3_URL}" || { echo "[FAIL] /ota/check 의 URL 이 방금 업로드한 URL 과 다릅니다"; exit 1; }
                    echo "${RESP}" | grep -qF "${FW_SHA256}" || { echo "[FAIL] /ota/check 의 SHA-256 이 방금 빌드와 다릅니다"; exit 1; }
                    echo "[OK] /ota/check 가 신규 펌웨어(URL, SHA-256)를 정확히 안내합니다"
                '''
            }
        }
    }

    post {
        always {
            sh '''
                echo "[CLEANUP] RAM 디스크 임시 빌드 파일 즉시 파기 (메모리 반환)"
                rm -rf "${RAMDISK}" "${DISK_DIR}"
            '''
        }
    }
}
